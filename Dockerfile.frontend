# PURPOSE: Streamlit portal image (talks to the API over HTTP only).
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir "streamlit>=1.50" "plotly>=5.20" "httpx>=0.27" "pyyaml>=6.0"
COPY frontend ./frontend
COPY config/ui.yaml ./config/ui.yaml
RUN useradd -m shield && chown -R shield /app
USER shield
EXPOSE 8501
CMD ["streamlit", "run", "frontend/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--browser.gatherUsageStats=false"]

# Copy to .env and edit. Secrets here are for deployment only; business rules live in config/*.yaml.
ENV=dev                          # production refuses to start with the default secrets
JWT_SECRET=change-me-long-random
VAULT_KEY=change-me-another-long-random      # encrypts vault entries and stored conversation memory
AUDIT_HMAC_KEY=change-me-third-long-random   # keys the audit hash chain and value HMACs
JWT_TTL_MINUTES=60

AUTH_PROVIDER=local              # local | oidc (stub)
SHOW_DEMO_HINT=true              # show demo accounts on the login page (set false in production)
SEED_DEMO_USERS=true             # create the demo users (password Demo@123); set false in production

DATABASE_URL=sqlite:///./shieldgate.db
# DATABASE_URL=postgresql+psycopg://shieldgate:shieldgate@postgres:5432/shieldgate
SESSION_STORE=memory             # memory | redis
REDIS_URL=redis://redis:6379/0

VECTOR_STORE=auto                # auto (chroma if installed) | chroma | memory
EMBEDDER=auto                    # auto (sentence-transformers if installed) | sentence_transformers | hash

LLM_PROVIDER=                    # empty = config/app.yaml (mock). mock | ollama | openai_compat | anthropic
LLM_MODEL=
LLM_BASE_URL=                    # ollama: http://ollama:11434   openai_compat: https://api.openai.com/v1
LLM_API_KEY=

API_URL=http://localhost:8000    # used by the Streamlit frontend
LOG_LEVEL=INFO

# Speed / quiet start-up when sentence-transformers is installed:
# HF_HUB_OFFLINE=1               # once the embedding model is downloaded: no network check at start (faster, no HF_TOKEN warning)
# HF_HUB_DISABLE_TELEMETRY=1
